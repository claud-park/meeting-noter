# 회의록 자동화 환경변수
# 이 파일을 .env로 복사 후 값을 채워주세요
# cp .env.example .env

# ── CLOVA Speech ──────────────────────────────────────────────────────
# 네이버 클라우드 플랫폼 콘솔 > CLOVA Speech > 도메인 > InvokeURL
CLOVA_INVOKE_URL=https://clovaspeech-gw.ncloud.com/external/v1/YOUR_DOMAIN_ID/YOUR_INVOKE_URL

# 네이버 클라우드 플랫폼 콘솔 > CLOVA Speech > 도메인 > Secret Key
CLOVA_SECRET_KEY=your_clova_secret_key_here

# ── Anthropic Claude ──────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# ── (선택) Confluence 자동 업로드 ─────────────────────────────────────
# CONFLUENCE_URL=https://your-domain.atlassian.net
# CONFLUENCE_EMAIL=your@email.com
# CONFLUENCE_API_TOKEN=your_confluence_api_token
# CONFLUENCE_SPACE_ID=2753331616
